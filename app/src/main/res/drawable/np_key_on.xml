<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF8A5D00"/>
            <corners android:radius="7dp"/>
            <stroke android:width="2dp" android:color="#FF2A241C"/>
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFFFD27A" android:endColor="#FFE8A21A"/>
            <corners android:radius="7dp"/>
            <stroke android:width="2dp" android:color="#FF2A241C"/>
        </shape>
    </item>
</layer-list>
