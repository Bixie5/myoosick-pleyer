<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:background="@drawable/np_wood" android:padding="4dp" android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/np_lcd" android:paddingLeft="9dp" android:paddingRight="9dp" android:paddingTop="6dp" android:paddingBottom="6dp"
            android:layout_marginTop="0dp">
            <TextView android:id="@+id/q_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="monospace" android:textStyle="bold" android:textSize="15sp" android:textColor="#FFFFB000"
                android:singleLine="true" android:ellipsize="end"/>
            <TextView android:id="@+id/q_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="monospace" android:textSize="12sp" android:textColor="#FFC98A00"
                android:singleLine="true" android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>
    <ImageButton android:id="@+id/q_play" android:layout_width="44dp" android:layout_height="40dp" android:layout_marginLeft="6dp"
        android:background="@drawable/np_key_play" android:padding="10dp" android:scaleType="centerInside"
        android:tint="#FFFFFFFF" android:contentDescription="Play or pause"/>
</LinearLayout>
